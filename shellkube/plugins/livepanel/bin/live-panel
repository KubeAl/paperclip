#!/usr/bin/env python3
"""live-panel: show live HTML on your current Paperclip task (plugin shellkube.livepanel).

  live-panel render [--panel P] [--title T] [--data JSON] [FILE|-]   # whole page; empty page removes the panel
  live-panel patch  [--panel P] --target CSS [--mode inner|outer|append|prepend|text|remove] [FILE|-|--html H]
  live-panel data   [--panel P] JSON                                  # shallow-merge into the panel data
  live-panel input  [--panel P] [--after N] [--wait SECONDS]          # what the user submitted (wait <= 25)

Uses PAPERCLIP_API_URL, PAPERCLIP_API_KEY, PAPERCLIP_AGENT_ID, PAPERCLIP_RUN_ID, PAPERCLIP_COMPANY_ID and
PAPERCLIP_TASK_ID (or --issue). Prints the tool result; exit 1 on error.
"""
import argparse, json, os, sys, urllib.request, urllib.error

E = os.environ


def call(path, body=None):
    req = urllib.request.Request(E["PAPERCLIP_API_URL"].rstrip("/") + path, method="POST" if body is not None else "GET",
                                 data=None if body is None else json.dumps(body).encode(),
                                 headers={"Authorization": "Bearer " + E["PAPERCLIP_API_KEY"], "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        sys.exit(f"live-panel: HTTP {e.code}: {e.read().decode()[:500]}")


def read(src):
    return sys.stdin.read() if src in (None, "-") else open(src).read()


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=["render", "patch", "data", "input"])
    ap.add_argument("arg", nargs="?")
    ap.add_argument("--issue", default=E.get("PAPERCLIP_TASK_ID"))
    ap.add_argument("--panel", default="main")
    ap.add_argument("--title")
    ap.add_argument("--data")
    ap.add_argument("--target")
    ap.add_argument("--mode", default="inner")
    ap.add_argument("--html")
    ap.add_argument("--after", type=int, default=0)
    ap.add_argument("--wait", type=float, default=0)
    a = ap.parse_args()
    if not a.issue:
        sys.exit("live-panel: no task: set PAPERCLIP_TASK_ID or pass --issue")
    p = {"issueId": a.issue, "panel": a.panel}
    if a.cmd == "render":
        tool, p["html"] = "live_render", read(a.arg)
        if a.title: p["title"] = a.title
        if a.data: p["data"] = json.loads(a.data)
    elif a.cmd == "patch":
        tool, html = "live_patch", a.html if a.html is not None else ("" if a.mode == "remove" else read(a.arg))
        p["ops"] = [{"target": a.target, "mode": a.mode, "html": html}] if a.target else []
        if a.data: p["data"] = json.loads(a.data)
    elif a.cmd == "data":
        tool, p["data"] = "live_patch", json.loads(a.arg)
    else:
        tool, p["after"], p["waitSeconds"] = "live_input", a.after, a.wait
    project = call(f"/api/issues/{a.issue}").get("projectId")
    res = call("/api/plugins/tools/execute", {"tool": "shellkube.livepanel:" + tool, "parameters": p, "runContext": {
        "agentId": E["PAPERCLIP_AGENT_ID"], "runId": E["PAPERCLIP_RUN_ID"], "companyId": E["PAPERCLIP_COMPANY_ID"], "projectId": project}})
    r = res.get("result", res) if isinstance(res, dict) else res
    if isinstance(r, dict) and r.get("error"):
        sys.exit("live-panel: " + str(r["error"]))
    print(r.get("content", json.dumps(r)) if isinstance(r, dict) else r)


main()
